+  const maxCandidateCount = collectionName ? Math.min(totalVectorCount, 4096) : initialCandidateCount;
+  let candidateCount = Math.min(initialCandidateCount, maxCandidateCount);
+  let vecResults: { hash_seq: string; distance: number }[] = [];
+  let docRows: {
