+  // lookup separate from the document JOIN: sqlite-vec hangs when they are
+  // combined in one query.
+  const initialCandidateCount = limit * 3;
+  const totalVectorCount = collectionName
+    ? (db.prepare(`SELECT count(*) as count FROM vectors_vec`).get() as { count: number }).count
+    : initialCandidateCount;
+  if (collectionName && totalVectorCount === 0) return [];
