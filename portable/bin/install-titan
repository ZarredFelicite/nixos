#!/usr/bin/env bash
# Run on the booted persistent portable USB, on the physical Framework only.
set +x
set -euo pipefail
umask 077
# Prefer NixOS setuid wrappers over their non-setuid package binaries.
export PATH=/run/wrappers/bin:/run/current-system/sw/bin:/etc/profiles/per-user/zarred/bin:$PATH
export PAGER=cat
self=$(realpath -e -- "${BASH_SOURCE[0]}")
flake=/home/zarred/dots
key=/home/zarred/.local/state/titan-provision/ssh_host_ed25519_key
recipient=age1nzlr59275d22ma4j3kecf2pmf46rq24mvldmlpgunt0ukw8gu9kq54g32w
usb_serial=0399123100003330
mount_root=/mnt/titan
min_bytes=120000000000
fail() { printf 'install-titan: %s\nNo automatic rollback or retry: inspect disk/mounts manually before recovery.\n' "$*" >&2; exit 1; }
usage() { printf '%s\n' 'Usage: install-titan [--plan] [--disk /dev/disk/by-id/...]' '       install-titan --apply --disk /dev/disk/by-id/...' '       install-titan --format-prebuilt <approved-by-id> <expected-resolved-device> <expected-serial> <prebuilt-disko-store-path> <expected-Web-Git-commit>' 'Plan is read-only and does not select a disk; apply requires a TTY and two typed confirmations.' 'Run only from the booted persistent portable USB on Titan. Never run from web.'; }
root_stage=0
finish_stage=0
format_stage=0
pki_check=0
if [[ ${1-} == --format-prebuilt ]]; then
  format_stage=1
  (( $# == 6 )) || fail 'invalid privileged prebuilt-format invocation'
  format_disk=$2 format_resolved=$3 format_serial=$4 format_disko=$5 format_commit=$6
  set --
elif [[ ${1-} == --root-stage ]]; then
  root_stage=1
  (( $# == 9 )) || fail 'invalid privileged invocation'
  root_disk=$2 root_resolved=$3 root_serial=$4 root_system=$5 root_disko=$6 root_key=$7 root_metadata=$8 root_metadata_sha=$9
  set --
elif [[ ${1-} == --finish-prebuilt ]]; then
  finish_stage=1
  (( $# == 8 )) || fail 'invalid prebuilt finish invocation'
  root_disk=$2 root_resolved=$3 root_serial=$4 root_system=$5 root_key=$6 root_metadata=$7 root_metadata_sha=$8
  set --
elif [[ ${1-} == --pki-check ]]; then
  pki_check=1
  (( $# == 1 )) || fail 'invalid privileged PKI-check invocation'
  set --
fi
mode=plan disk_id=
while (( $# )); do
  case $1 in
    --help|-h) usage; exit 0 ;;
    --plan) [[ $mode == plan ]] || fail 'conflicting modes' ;;
    --apply) mode=apply ;;
    --disk) (( $# >= 2 )) || fail 'missing disk path'; disk_id=$2; shift ;;
    *) fail "unrecognized option: $1" ;;
  esac
  shift
done
if (( pki_check )); then
  [[ $(id -u) == 0 && $(hostname) == portable-usb ]] || fail 'privileged PKI check requires root on USB'
elif (( ! root_stage && ! finish_stage && ! format_stage )); then
  [[ $mode == plan || -n $disk_id ]] || fail 'explicit --disk required for apply'
  [[ $(id -u) == 1000 && $HOME == /home/zarred && $(hostname) == portable-usb ]] || fail 'must run as zarred on the booted portable USB (not web)'
else
  [[ $(id -u) == 0 && $(hostname) == portable-usb && -t 0 && -t 1 && -t 2 ]] || fail 'privileged stage requires root on USB and a live TTY'
fi
[[ -d /sys/firmware/efi ]] || fail 'UEFI boot required'
read_efi_var() {
  local name=$1 file value
  for file in /sys/firmware/efi/efivars/"$name"-*; do
    [[ -r $file ]] || continue
    value=$(od -An -tu1 -j4 -N1 -- "$file" | xargs) || fail "$name state unreadable"
    [[ $value == 0 || $value == 1 ]] || fail "$name state invalid"
    printf '%s\n' "$value"
    return 0
  done
  return 1
}
if (( ! finish_stage )); then
  secure_boot=$(read_efi_var SecureBoot) || fail 'Secure Boot state unavailable'
  if [[ $secure_boot == 1 ]]; then
    for mode_var in SetupMode AuditMode; do
      if mode_value=$(read_efi_var "$mode_var"); then
        [[ $mode_value == 0 ]] || fail "$mode_var must be disabled for enforced Secure Boot"
      fi
    done
  fi
fi
pki=/var/lib/sbctl
pki_cert=$pki/keys/db/db.pem
pki_key=$pki/keys/db/db.key
check_pki() {
  local key_public_hash cert_public_hash
  [[ -d $pki && ! -L $pki && $(stat -c %u -- "$pki") == 0 && $(stat -c %a -- "$pki") == 700 ]] || fail 'signing PKI directory must be root-owned mode 0700 at /var/lib/sbctl on the encrypted USB'
  [[ -f $pki_cert && ! -L $pki_cert && $(stat -c %u -- "$pki_cert") == 0 ]] || fail 'db signing certificate missing or not root-owned'
  [[ -f $pki_key && ! -L $pki_key && $(stat -c %u -- "$pki_key") == 0 && $(stat -c %a -- "$pki_key") == 600 ]] || fail 'db signing private key missing or not root-only'
  openssl x509 -in "$pki_cert" -noout -checkend 0 >/dev/null 2>&1 || fail 'db signing certificate is invalid or expired'
  openssl pkey -in "$pki_key" -passin pass: -check -noout >/dev/null 2>&1 || fail 'db signing private key is invalid or passphrase-protected'
  key_public_hash=$(openssl pkey -in "$pki_key" -passin pass: -pubout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum) || fail 'cannot derive signing key public fingerprint'
  cert_public_hash=$(openssl x509 -in "$pki_cert" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum) || fail 'cannot derive signing certificate fingerprint'
  [[ $key_public_hash == "$cert_public_hash" ]] || fail 'db signing key does not match db certificate'
  [[ -z $(find "$pki" -type l -print -quit) ]] || fail 'signing PKI contains symlinks'
  [[ -z $(find "$pki" \( ! -user root -o -perm /022 \) -print -quit) ]] || fail 'signing PKI contains non-root-owned or group/world-writable files'
  [[ $(findmnt -rn --mountpoint /boot -o FSTYPE) == vfat && \
     -f /boot/EFI/BOOT/BOOTX64.EFI && ! -L /boot/EFI/BOOT/BOOTX64.EFI ]] || fail 'booted USB EFI fallback loader missing or /boot is not its VFAT ESP'
  sbverify --cert "$pki_cert" /boot/EFI/BOOT/BOOTX64.EFI >/dev/null 2>&1 || fail 'booted USB EFI fallback signature does not verify with configured db certificate'
}
for cmd in lsblk realpath findmnt stat udevadm grep ssh-keygen ssh-to-age sops nix nix-store sudo mkpasswd git flock nixos-install cp install chown cmp chmod cut xargs jq mktemp sha256sum od rm openssl sbverify find python3; do
  command -v "$cmd" >/dev/null || fail "missing $cmd; add it to the USB image before installing"
done
if (( pki_check )); then
  check_pki
  printf '%s\n' 'Root-only signing PKI validated; firmware certificate enrollment was not checked.'
  exit 0
fi
# Product strings vary by BIOS revision: require Framework manufacturer and a Framework Laptop 13 product.
manufacturer=$(< /sys/class/dmi/id/sys_vendor)
product=$(< /sys/class/dmi/id/product_name)
[[ $manufacturer == 'Framework' && $product == *'Laptop 13'* ]] || fail "DMI is not a Framework Laptop 13 ($manufacturer / $product)"
[[ -f $flake/flake.nix && -f $flake/flake.lock && -f $flake/hosts/titan/disko.nix && -f $flake/hosts/titan/target-disk.nix ]] || fail 'full root Titan flake missing from /home/zarred/dots'
if (( ! finish_stage )); then
  [[ ! -L $mount_root && -z $(findmnt -rn --mountpoint "$mount_root" -o TARGET) ]] || fail "$mount_root symlinked or already mounted"
fi

check_disk() {
  local path=$1 expected=${2-} mounted_ok=${3-0} child name props count line uuid parent udevserial mountpoint
  [[ $path == /dev/disk/by-id/* && $path != *$'\n'* && $path != *'"'* && $path != *'\\'* ]] || fail 'disk must be a simple /dev/disk/by-id path'
  [[ $path != *-part[0-9]* ]] || fail 'partition ID is not a disk'
  [[ -L $path ]] || fail 'disk by-id symlink missing'
  resolved=$(realpath -e -- "$path") || fail 'cannot resolve disk'
  [[ -z $expected || $resolved == "$expected" ]] || fail 'target device changed'
  [[ $(lsblk -dnro TYPE -- "$resolved") == disk ]] || fail 'not a whole disk'
  [[ $(lsblk -dnro RM -- "$resolved") == 0 && $(lsblk -dnro HOTPLUG -- "$resolved") == 0 ]] || fail 'removable or hotplug disk'
  tran=$(lsblk -dnro TRAN -- "$resolved")
  [[ $tran == nvme || $tran == sata ]] || fail "unexpected transport: $tran"
  size=$(lsblk -bdnro SIZE -- "$resolved")
  [[ $size =~ ^[0-9]+$ && $size -ge $min_bytes ]] || fail 'disk below 120 GB minimum'
  model=$(lsblk -dnro MODEL -- "$resolved" | xargs)
  serial=$(lsblk -dnro SERIAL -- "$resolved" | xargs)
  [[ -n $model && -n $serial && $serial != "$usb_serial" ]] || fail 'missing model/serial or portable USB selected'
  props=$(udevadm info --query=property --name="$resolved") || fail 'udev disk metadata unavailable'
  udevserial=$(printf '%s\n' "$props" | grep '^ID_SERIAL_SHORT=' || true)
  [[ $udevserial == "ID_SERIAL_SHORT=$serial" ]] || fail 'udev serial mismatch or ambiguous serial'
  [[ $(realpath -e -- "$path") == "$resolved" ]] || fail 'by-id path changed'
  # Check every partition and mapper child, not just the parent. Any holder, mount or swap is fatal.
  while IFS= read -r child; do
    [[ -b $child ]] || fail 'disk descendant disappeared'
    name=$(lsblk -dnro KNAME -- "$child")
    [[ $name =~ ^[a-zA-Z0-9._-]+$ ]] || fail 'unsafe block name'
    if (( ! mounted_ok )); then
      for parent in /sys/class/block/"$name"/holders/*; do
        [[ ! -e $parent ]] || fail "active holder on $child"
      done
      [[ -z $(lsblk -nrpo MOUNTPOINTS -- "$child" | grep -v '^$' || true) ]] || fail "mounted descendant: $child"
      [[ -z $(findmnt -rn -S "$child" -o TARGET) ]] || fail "mounted device: $child"
    else
      while IFS= read -r mountpoint; do
        case $mountpoint in
          "$mount_root"|"$mount_root/home/zarred"|"$mount_root/persist"|"$mount_root/nix"|"$mount_root/boot") ;;
          *) fail "unexpected mount on approved SSD: $child ($mountpoint)" ;;
        esac
      done < <(findmnt -rn -S "$child" -o TARGET)
    fi
    while read -r line _; do
      [[ $line != "$child" && $(realpath -e -- "$line" 2>/dev/null || true) != "$child" ]] || fail "swap active on $child"
    done < /proc/swaps
    uuid=$(lsblk -dnro UUID -- "$child")
    case ${uuid^^} in
      54E2-2E21|71E6355F-BE02-4E5C-9BB2-7A9022F925F0|3DE76D8B-C3E1-4045-9B0F-FBE78848B0C0) fail 'portable USB partition UUID detected' ;;
    esac
  done < <(lsblk -nrpo PATH -- "$resolved")
  # Exclude the USB by independently tracing each known UUID to its parent disk.
  for uuid in 54E2-2E21 71e6355f-be02-4e5c-9bb2-7a9022f925f0 3de76d8b-c3e1-4045-9b0f-fbe78848b0c0; do
    [[ -e /dev/disk/by-uuid/$uuid ]] || fail "portable USB UUID missing: $uuid"
    parent=$(lsblk -dnro PKNAME -- "/dev/disk/by-uuid/$uuid")
    [[ -n $parent && $(realpath -e -- "/dev/$parent") != "$resolved" ]] || fail 'portable USB is the target'
  done
}

if (( format_stage )); then
  approved_disk=/dev/disk/by-id/nvme-Samsung_SSD_9100_PRO_2TB_S7YCNJ0L219298W
  [[ $format_disk == "$approved_disk" && $format_serial == S7YCNJ0L219298W ]] || fail 'prebuilt format is restricted to the approved Titan SSD identity'
  [[ $format_resolved =~ ^/dev/[a-zA-Z0-9._-]+$ ]] || fail 'invalid expected resolved device'
  [[ $format_commit =~ ^[0-9a-f]{40}$ ]] || fail 'expected Web commit must be a full 40-character hash'
  [[ $format_disko =~ ^/nix/store/[a-z0-9]{32}-[^/]+$ && -x $format_disko/bin/disko-destroy-format-mount ]] || fail 'invalid prebuilt Disko store path'
  nix-store --check-validity "$format_disko" || fail 'prebuilt Disko path is not valid in the USB Nix store'

  git -C "$flake" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail 'USB checkout is not a Git worktree'
  [[ $(git -C "$flake" rev-parse HEAD) == "$format_commit" ]] || fail 'USB checkout does not match the expected Web commit'
  [[ -z $(git -C "$flake" status --porcelain) ]] || fail 'USB checkout is not clean'
  git -C "$flake" ls-files --error-unmatch -- hosts/titan/target-disk.nix >/dev/null || fail 'target-disk.nix is not tracked'
  target_device_line="  disko.devices.disk.main.device = \"$approved_disk\";"
  target_mount_line="  disko.rootMountPoint = \"$mount_root\";"
  [[ $(grep -Fxc -- "$target_device_line" "$flake/hosts/titan/target-disk.nix") == 1 && \
     $(grep -Fxc -- "$target_mount_line" "$flake/hosts/titan/target-disk.nix") == 1 ]] || fail 'committed target-disk.nix assignments do not match the approved disk and mount root'

  check_preformat_state() {
    local mounted_target part_path part_type part_num part_fstype has_crypt=0 has_esp=0 has_luks=0
    while IFS= read -r mounted_target; do
      case $mounted_target in
        "$mount_root"|"$mount_root"/*) fail "stale target mount exists: $mounted_target" ;;
      esac
    done < <(findmnt -rn -o TARGET)
    while read -r part_path part_type part_num part_fstype _; do
      [[ $part_type == crypt ]] && has_crypt=1
      if [[ $part_type == part && $part_num == 1 && ${part_fstype,,} == vfat ]]; then has_esp=1; fi
      if [[ $part_type == part && $part_num == 2 && ${part_fstype,,} == crypto_luks ]]; then has_luks=1; fi
    done < <(lsblk -nrpo PATH,TYPE,PARTN,FSTYPE -- "$format_resolved")
    (( ! has_crypt )) || fail 'target already has an active encrypted mapper; close it and inspect manually'
    (( ! (has_esp && has_luks) )) || fail 'target already has the Titan Disko ESP/LUKS layout; refusing to overwrite an installed or previously formatted system'
  }
  check_preformat_state
  check_disk "$format_disk" "$format_resolved"
  [[ $resolved == "$format_resolved" && $serial == "$format_serial" ]] || fail 'approved target identity changed'
  root_source=$(findmnt -rn --mountpoint / -o SOURCE) || fail 'cannot identify live USB root'
  esp_source=$(findmnt -rn --mountpoint /boot -o SOURCE) || fail 'cannot identify live USB ESP'
  [[ $(findmnt -rn --mountpoint /boot -o FSTYPE) == vfat ]] || fail 'live USB ESP is not mounted as VFAT'
  root_on_usb=0
  for usb_uuid in 71E6355F-BE02-4E5C-9BB2-7A9022F925F0 3DE76D8B-C3E1-4045-9B0F-FBE78848B0C0; do
    if lsblk -snrpo UUID -- "$root_source" 2>/dev/null | grep -Fxiq -- "$usb_uuid"; then root_on_usb=1; fi
  done
  lsblk -snrpo UUID -- "$esp_source" 2>/dev/null | grep -Fxiq -- '54E2-2E21' || fail 'live ESP is not backed by the known portable USB ESP UUID'
  (( root_on_usb )) || fail 'live root is not backed by a known portable USB root UUID'

  printf 'DESTRUCTIVE: Disko will format %s, serial %s. Type exactly WIPE %s: ' "$format_disk" "$format_serial" "$format_serial" >/dev/tty
  IFS= read -r format_reply </dev/tty || fail 'wipe confirmation unavailable'
  [[ $format_reply == "WIPE $format_serial" ]] || fail 'wipe confirmation failed'
  # Recheck immediately before the sole destructive operation; never retry Disko.
  check_preformat_state
  check_disk "$format_disk" "$format_resolved"
  [[ $resolved == "$format_resolved" && $serial == "$format_serial" ]] || fail 'approved target identity changed before formatting'
  "$format_disko/bin/disko-destroy-format-mount" || fail 'Disko formatting failed; inspect target manually and do not retry automatically'
  printf '%s\n' 'Disko formatting completed; target mounts remain in place for the later import stage.'
  exit 0
fi

# Validate NUL-delimited HM directory/file records before touching disk and again as root.
validate_metadata() {
  local input=$1 kind entry segment seen_dots=0 seen_scripts=0 count=0 path_re='^[a-zA-Z0-9._/ -]+$'
  [[ -f $input && ! -L $input && $(stat -c %u -- "$input") == 1000 && $(stat -c %a -- "$input") == 600 ]] || fail 'unsafe HM metadata file'
  while IFS= read -r -d '' kind; do
    IFS= read -r -d '' entry || fail 'truncated HM metadata'
    [[ $kind == D || $kind == F ]] || fail 'unknown HM metadata record'
    [[ -n $entry && $entry != /* && $entry != */ && $entry != *//* ]] || fail 'invalid HM persistence path'
    [[ $entry != *$'\n'* && $entry != *$'\r'* && $entry != *$'\t'* && $entry != *'\\'* && $entry != *'"'* && $entry != *"'"* ]] || fail 'unsafe HM persistence characters'
    [[ $entry =~ $path_re ]] || fail 'unsupported HM persistence characters'
    IFS=/ read -ra parts <<< "$entry"
    for segment in "${parts[@]}"; do [[ -n $segment && $segment != . && $segment != .. ]] || fail 'HM persistence path traversal'; done
    case ${parts[0]} in etc|var|secrets|nix|home|root) fail 'HM path overlaps root-managed persistence' ;; esac
    [[ $kind != D || $entry != dots ]] || seen_dots=1
    [[ $kind != D || $entry != scripts ]] || seen_scripts=1
    (( count += 1 ))
  done < "$input"
  (( count > 0 && seen_dots && seen_scripts )) || fail 'HM persistence lacks dots or scripts directories'
}

# Home Manager's /persist bind units source paths under /persist/home/zarred.
# Keep the traversed parent searchable but not listable; the user's home itself
# and its persisted content stay private. /persist remains root-managed.
ensure_user_persistence_home() {
  local persist_home=$mount_root/persist/home user_home=$mount_root/persist/home/zarred
  [[ -d $mount_root/persist && ! -L $mount_root/persist ]] || fail 'unsafe persistence root'
  [[ ! -L $persist_home && ( ! -e $persist_home || -d $persist_home ) ]] || fail 'unsafe persistence home parent'
  [[ ! -L $user_home && ( ! -e $user_home || -d $user_home ) ]] || fail 'unsafe persisted user home'
  install -d -o 1000 -g 100 -m 0711 -- "$persist_home"
  install -d -o 1000 -g 100 -m 0700 -- "$user_home"
}

# Create only the generated HM bind-source paths under the user's persisted home.
user_directory() {
  local relative=$1 part current=$mount_root/persist/home/zarred
  IFS=/ read -ra components <<< "$relative"
  for part in "${components[@]}"; do
    current+=/$part
    [[ ! -L $current && ( ! -e $current || -d $current ) ]] || fail "unsafe existing persistence path: $relative"
    install -d -o 1000 -g 100 -m 0700 -- "$current"
  done
}

if (( root_stage || finish_stage )); then
  [[ $root_resolved == /dev/* && $root_serial =~ ^[a-zA-Z0-9._-]+$ ]] || fail 'invalid root-stage identity'
  if (( finish_stage )); then
    [[ $root_disk == /dev/disk/by-id/nvme-Samsung_SSD_9100_PRO_2TB_S7YCNJ0L219298W && \
       $root_serial == S7YCNJ0L219298W ]] || fail 'prebuilt finish is restricted to the approved Titan SSD identity'
    [[ $root_system =~ ^/nix/store/[a-z0-9]{32}-nixos-system-titan-.+$ ]] || fail 'invalid logical Titan system store path'
  else
    [[ $root_system == /nix/store/* && -d $root_system && $root_disko == /nix/store/* && -x $root_disko/bin/disko-destroy-format-mount ]] || fail 'prebuilt paths invalid'
  fi
  [[ $root_key == /home/zarred/.local/state/titan-provision/ssh_host_ed25519_key && -f $root_key && ! -L $root_key ]] || fail 'Titan key missing'
  if (( root_stage )); then
    [[ ! -e $mount_root && ! -L $mount_root ]] || fail 'mount root already exists or is a symlink'
  else
    [[ -d $mount_root && ! -L $mount_root ]] || fail 'preformatted target root is missing or symlinked'
  fi
  [[ $root_metadata == /run/user/1000/titan-hm.* && $root_metadata_sha =~ ^[0-9a-f]{64}$ ]] || fail 'unexpected HM metadata location/hash'
  [[ $(sha256sum < "$root_metadata" | cut -d' ' -f1) == "$root_metadata_sha" ]] || fail 'HM metadata changed'
  validate_metadata "$root_metadata"
  check_pki
  if (( finish_stage )); then
    check_disk "$root_disk" "$root_resolved" 1
  else
    check_disk "$root_disk" "$root_resolved"
  fi
  [[ $serial == "$root_serial" ]] || fail 'disk serial changed before installation'
  if (( root_stage )); then
    # Disko's generated script is pinned and prebuilt with /mnt/titan as rootMountPoint.
    # Its own wipe confirmation remains enabled, as a third independent confirmation.
    printf 'sudo authorized; Disko will request its own confirmation and LUKS passphrase on this TTY.\n'
    install -d -m 0755 -- "$mount_root"
    "$root_disko/bin/disko-destroy-format-mount" || fail 'Disko incomplete; inspect partitions, LUKS mapping and mounts manually'
  fi
  [[ $(findmnt -rn --mountpoint "$mount_root" -o FSTYPE) == tmpfs && \
     $(findmnt -rn --mountpoint "$mount_root/home/zarred" -o FSTYPE) == tmpfs && \
     $(findmnt -rn --mountpoint "$mount_root/persist" -o FSTYPE) == btrfs && \
     $(findmnt -rn --mountpoint "$mount_root/nix" -o FSTYPE) == btrfs && \
     $(findmnt -rn --mountpoint "$mount_root/boot" -o FSTYPE) == vfat ]] || fail 'target mounts do not match expected layout'
  if (( finish_stage )); then
    for mountpoint in "$mount_root/nix" "$mount_root/persist" "$mount_root/boot"; do
      source=$(findmnt -rn --mountpoint "$mountpoint" -o SOURCE)
      source=${source%%\[*}
      [[ -b $source ]] || fail "target mount source is not a block device: $mountpoint"
      if [[ $mountpoint == "$mount_root/boot" ]]; then
        [[ $(lsblk -dnro TYPE -- "$source") == part ]] || fail 'target EFI mount is not a partition'
      else
        [[ $(lsblk -dnro TYPE -- "$source") == crypt ]] || fail "target btrfs mount is not encrypted: $mountpoint"
      fi
      lsblk -snrpo PATH -- "$source" | grep -Fxq -- "$resolved" || fail "target mount is not backed by approved SSD: $mountpoint"
    done
    for directory in "$mount_root/home" "$mount_root/nix" "$mount_root/persist"; do
      [[ -d $directory && ! -L $directory && $(stat -c %u -- "$directory") == 0 ]] || fail "expected root-owned target mountpoint missing or unsafe: $directory"
      mode=$(stat -c %a -- "$directory")
      [[ $mode == 700 || $mode == 755 ]] || fail "unexpected target mountpoint mode at $directory: $mode"
    done
    home_user=$mount_root/home/zarred
    [[ -d $home_user && ! -L $home_user && $(stat -c %u:%g:%a -- "$home_user") == 1000:100:700 ]] || fail 'target home must remain zarred-owned mode 0700'
    store=$mount_root/nix/store
    [[ -d $store && ! -L $store && $(stat -c %u -- "$store") == 0 ]] || fail 'target Nix store missing or not root-owned'
    store_mode=$(stat -c %a -- "$store")
    [[ $store_mode == 700 || $store_mode == 1775 ]] || fail "unexpected target Nix store mode: $store_mode"
    # Open only the root-owned mountpoints Disko initializes as 0700. Preserve
    # private home permissions and Nix store sticky/group semantics.
    for directory in "$mount_root/home" "$mount_root/nix" "$mount_root/persist"; do
      [[ $(stat -c %a -- "$directory") == 755 ]] || chmod 0755 -- "$directory"
    done
    [[ $store_mode == 1775 ]] || chmod 1775 -- "$store"
    [[ -d "$mount_root$root_system" && ! -L "$mount_root$root_system" ]] || fail 'prebuilt system path absent from target Nix store'
    nix-store --store "local?root=$mount_root" --verify-path "$root_system" >/dev/null || fail 'prebuilt system path failed target-store verification'
  fi
  [[ -d $mount_root/persist && ! -L $mount_root/persist && ! -L $mount_root/persist/home ]] || fail 'unsafe persistence path'
  # Non-root system services must traverse /var/lib; keep the sbctl subtree 0700.
  install -d -o 0 -g 0 -m 0755 -- "$mount_root/persist/var" "$mount_root/persist/var/lib"
  [[ ! -e $mount_root/persist/var/lib/sbctl && ! -L $mount_root/persist/var/lib/sbctl ]] || fail 'signing PKI destination already exists'
  cp -a -- "$pki" "$mount_root/persist/var/lib/sbctl" || fail 'cannot preserve signing PKI in encrypted persistence'
  chown -R 0:0 -- "$mount_root/persist/var/lib/sbctl"
  chmod -R go-rwx -- "$mount_root/persist/var/lib/sbctl"
  [[ $(stat -c %a -- "$mount_root/persist/var/lib/sbctl") == 700 && \
     $(stat -c %a -- "$mount_root/persist/var/lib/sbctl/keys/db/db.key") == 600 ]] || fail 'persisted signing PKI permissions are not root-only'
  install -d -m 0700 -- "$mount_root/persist/secrets" "$mount_root/persist/etc/ssh"
  printf 'Titan login password (input hidden): ' >&2
  IFS= read -rs password </dev/tty || fail 'login password unavailable'
  printf '\nRepeat Titan login password (input hidden): ' >&2
  IFS= read -rs confirm </dev/tty || fail 'login confirmation unavailable'
  printf '\n' >&2
  [[ -n $password && $password == "$confirm" ]] || fail 'login password mismatch/empty; no login hash written'
  unset confirm
  hash=$(printf '%s' "$password" | mkpasswd -m yescrypt --stdin) || fail 'password hashing failed'
  unset password
  [[ $hash == '$y$'* ]] || fail 'unexpected password hash format'
  # Never pass hash or password in argv; write only to encrypted /persist.
  printf '%s\n' "$hash" > "$mount_root/persist/secrets/zarred-password-hash"
  unset hash
  chmod 0400 -- "$mount_root/persist/secrets/zarred-password-hash"
  install -m 0600 -- "$root_key" "$mount_root/persist/etc/ssh/ssh_host_ed25519_key"
  install -m 0644 -- "$root_key.pub" "$mount_root/persist/etc/ssh/ssh_host_ed25519_key.pub"
  # Build precisely the generated HM bind-source tree under /persist/home/zarred.
  # Directory records create their full sources; file records create their parents.
  # Root-managed /persist/etc, /persist/var, and /persist/secrets remain separate.
  ensure_user_persistence_home
  while IFS= read -r -d '' kind; do
    IFS= read -r -d '' entry || fail 'truncated HM metadata after formatting'
    if [[ $kind == D ]]; then user_directory "$entry"; elif [[ $entry == */* ]]; then
      user_directory "${entry%/*}"
    fi
  done < "$root_metadata"
  [[ -d /home/zarred/scripts && ! -L /home/zarred/scripts ]] || fail 'USB user scripts missing; cannot provision persistent scripts'
  persist_home=$mount_root/persist/home/zarred
  cp -a -- "$flake/." "$persist_home/dots/" || fail 'persistent flake copy failed'
  cp -a -- /home/zarred/scripts/. "$persist_home/scripts/" || fail 'persistent scripts copy failed'
  chown -R 1000:100 -- "$persist_home/dots" "$persist_home/scripts"
  cmp -s -- "$flake/hosts/titan/target-disk.nix" "$persist_home/dots/hosts/titan/target-disk.nix" || fail 'persisted target configuration differs'
  # Titan's HM profile enables Quickshell but does not generate its primary config.
  # Provision the known-good USB config into the actual encrypted bind source.
  primary_source=$flake/portable/config/quickshell/primary
  primary_dest=$persist_home/.config/quickshell/primary
  [[ -d $primary_source && ! -L $primary_source && -f $primary_source/shell.qml && -f $primary_source/config.qml ]] || fail 'portable Quickshell primary config is missing'
  [[ -d $persist_home/.config/quickshell && ! -L $persist_home/.config/quickshell && ! -e $primary_dest && ! -L $primary_dest ]] || fail 'Quickshell persistence bind source is missing or already populated'
  cp -a -- "$primary_source" "$primary_dest" || fail 'Quickshell persistent config copy failed'
  chown -R 1000:100 -- "$primary_dest"
  cmp -s -- "$primary_source/config.qml" "$primary_dest/config.qml" || fail 'persisted Quickshell config differs'
  # The generated system declares Web's public login keys, but Nix store
  # traversal can prevent sshd from reading /etc/ssh/authorized_keys.d.
  # Install only those same declared public keys into the encrypted home bind.
  etc_store=$(readlink -- "$mount_root$root_system/etc") || fail 'Titan generated /etc store link missing'
  [[ $etc_store =~ ^/nix/store/[a-z0-9]{32}-etc/etc$ ]] || fail 'unsafe Titan generated /etc link'
  authorized_store=$(readlink -- "$mount_root$etc_store/ssh/authorized_keys.d/zarred") || fail 'Titan generated public login keys missing'
  [[ $authorized_store =~ ^/nix/store/[a-z0-9]{32}-zarred-authorized_keys$ ]] || fail 'unsafe generated public login keys path'
  authorized_source=$mount_root$authorized_store
  authorized_dest=$persist_home/.ssh/authorized_keys
  [[ -f $authorized_source && ! -L $authorized_source && $(stat -c %u:%a -- "$authorized_source") == 0:444 ]] || fail 'Titan declared public login keys are unsafe'
  ssh-keygen -lf "$authorized_source" >/dev/null || fail 'Titan declared public login keys are invalid'
  [[ -d $persist_home/.ssh && ! -L $persist_home/.ssh && $(stat -c %u:%g:%a -- "$persist_home/.ssh") == 1000:100:700 && ! -e $authorized_dest && ! -L $authorized_dest ]] || fail 'encrypted user SSH bind source is unsafe or already populated'
  install -o 1000 -g 100 -m 0600 -- "$authorized_source" "$authorized_dest"
  cmp -s -- "$authorized_source" "$authorized_dest" || fail 'persisted authorized keys differ from the declared keys'
  # Lanzaboote resolves its signing PKI at /var/lib/sbctl inside the target root;
  # expose the encrypted-persistence copy only for nixos-install, then always unbind.
  persisted_pki=$mount_root/persist/var/lib/sbctl
  [[ -d $persisted_pki && ! -L $persisted_pki && $(stat -c %u:%a -- "$persisted_pki") == 0:700 ]] || fail 'persisted signing PKI directory is unsafe'
  [[ -f $persisted_pki/keys/db/db.pem && ! -L $persisted_pki/keys/db/db.pem && \
     $(stat -c %u -- "$persisted_pki/keys/db/db.pem") == 0 && \
     -f $persisted_pki/keys/db/db.key && ! -L $persisted_pki/keys/db/db.key && \
     $(stat -c %u:%a -- "$persisted_pki/keys/db/db.key") == 0:600 ]] || fail 'persisted signing PKI certificate or private key is missing/unsafe'
  pki_dest=$mount_root/var/lib/sbctl
  [[ ! -L $mount_root/var && ( ! -e $mount_root/var || -d $mount_root/var ) ]] || fail 'target /var is unsafe'
  install -d -o 0 -g 0 -m 0755 -- "$mount_root/var/lib"
  [[ -d $mount_root/var/lib && ! -L $mount_root/var/lib ]] || fail 'target /var/lib is unsafe'
  [[ -z $(findmnt -rn --mountpoint "$mount_root/var/lib" -o TARGET) ]] || fail 'target /var/lib is already a mountpoint'
  [[ -z $(findmnt -rn --mountpoint "$pki_dest" -o TARGET) ]] || fail 'target signing PKI path is already a mountpoint'
  [[ ! -L $pki_dest && ( ! -e $pki_dest || -d $pki_dest ) ]] || fail 'target signing PKI destination is unsafe'
  if [[ -d $pki_dest ]]; then
    [[ $(stat -c %u -- "$pki_dest") == 0 && -z $(ls -A -- "$pki_dest") ]] || fail 'target signing PKI destination is not empty and root-owned'
  fi
  install -d -o 0 -g 0 -m 0700 -- "$pki_dest"
  [[ $(stat -c %u:%a -- "$pki_dest") == 0:700 ]] || fail 'target signing PKI mountpoint ownership/mode is unsafe'
  pki_bound=0
  cleanup_pki_bind() {
    local rc=$?
    trap - EXIT
    if (( pki_bound )) && [[ -n $(findmnt -rn --mountpoint "$pki_dest" -o TARGET) ]]; then
      if ! umount -- "$pki_dest"; then
        printf 'install-titan: temporary signing PKI bind remains mounted at %s; inspect manually.\n' "$pki_dest" >&2
        exit 1
      fi
    fi
    exit "$rc"
  }
  trap cleanup_pki_bind EXIT
  pki_bound=1
  mount --bind "$persisted_pki" "$pki_dest" || fail 'cannot temporarily bind encrypted signing PKI into target root'
  [[ -f $pki_dest/keys/db/db.pem && ! -L $pki_dest/keys/db/db.pem && \
     -f $pki_dest/keys/db/db.key && ! -L $pki_dest/keys/db/db.key && \
     $(stat -c %a -- "$pki_dest") == 700 ]] || fail 'temporary signing PKI bind verification failed'
  python3 "${self%/*}/provision-titan-wifi" || fail 'Wi-Fi provisioning failed; no credential was copied outside encrypted persistence'
  nixos-install --system "$root_system" --root "$mount_root" --no-root-password --no-channel-copy || fail 'installation incomplete; inspect mounted target; do not rerun Disko'
  umount -- "$pki_dest" || fail 'cannot remove temporary signing PKI bind; inspect target before recovery'
  pki_bound=0
  trap - EXIT
  [[ -L $mount_root/nix/var/nix/profiles/system ]] || fail 'installed system profile absent'
  [[ -f $mount_root/boot/EFI/BOOT/BOOTX64.EFI && ! -L $mount_root/boot/EFI/BOOT/BOOTX64.EFI ]] || fail 'signed EFI fallback loader missing'
  mapfile -t ukis < <(compgen -G "$mount_root/boot/EFI/Linux/*.efi" || true)
  (( ${#ukis[@]} > 0 )) || fail 'signed UKI missing from EFI/Linux'
  sbverify --cert "$pki_cert" "$mount_root/boot/EFI/BOOT/BOOTX64.EFI" >/dev/null 2>&1 || fail 'EFI fallback loader signature does not verify with the configured db certificate'
  for uki in "${ukis[@]}"; do
    [[ -f $uki && ! -L $uki ]] || fail 'unsafe UKI artifact'
    sbverify --cert "$pki_cert" "$uki" >/dev/null 2>&1 || fail "UKI signature does not verify with configured db certificate: ${uki##*/}"
  done
  /run/current-system/sw/bin/bash "${self%/*}/titan-enroll-tpm" /dev/disk/by-id/nvme-Samsung_SSD_9100_PRO_2TB_S7YCNJ0L219298W-part2 root || fail 'TPM enrollment did not complete; installed signed fallbacks and passphrase remain available'
  printf '%s\n' 'System installed. Leave mounts in place for manual inspection; do not re-run the formatter.'
  exit 0
fi

if [[ -n $disk_id ]]; then
  check_disk "$disk_id"
  printf 'Candidate: %s -> %s | %s | serial %s | %s bytes | %s\n' "$disk_id" "$resolved" "$model" "$serial" "$size" "$tran"
else
  printf '%s\n' 'No target chosen. Inspect: lsblk -p -o PATH,TYPE,TRAN,RM,HOTPLUG,SIZE,MODEL,SERIAL,UUID,MOUNTPOINTS'
fi
if [[ $mode == plan ]]; then
  printf '%s\n' 'Read-only plan complete. Apply needs explicit --disk and two confirmations; no disk writes performed.'
  exit 0
fi
[[ -t 0 && -t 1 && -t 2 ]] || fail 'apply needs an interactive TTY for sudo and LUKS prompts'
[[ -d /home/zarred/scripts && ! -L /home/zarred/scripts ]] || fail 'USB scripts missing; must be available before formatting'
[[ -d /run/user/1000 && $(stat -c %u -- /run/user/1000) == 1000 ]] || fail 'user runtime unavailable for HM metadata'
printf 'preflight-only' | mkpasswd -m yescrypt --stdin >/dev/null || fail 'mkpasswd lacks yescrypt support; install whois on USB before apply'
[[ ! -e $mount_root && ! -L $mount_root ]] || fail "$mount_root already exists or is a symlink; inspect manually"
[[ -r $key && ! -L $key && $(stat -c %a -- "$key") == 600 && $(stat -c %a -- "${key%/*}") == 700 ]] || fail 'Titan-only private host key missing or insecure on USB; provision it separately first'
[[ $(stat -c %u -- "$key") == 1000 ]] || fail 'Titan host key not owned by zarred'
[[ -f $key.pub && ! -L $key.pub ]] || fail 'Titan host public key missing'
actual_pub=$(ssh-keygen -y -f "$key" </dev/null) || fail 'Titan SSH key invalid or passphrase-protected'
[[ ${actual_pub% *} == "$(< "$key.pub")" || ${actual_pub% *} == "$(cut -d' ' -f1,2 "$key.pub")" ]] || fail 'Titan host public/private key mismatch'
[[ $(ssh-to-age < "$key.pub") == "$recipient" ]] || fail 'Titan SSH age recipient mismatch'
[[ $(grep -Fc -- "$recipient" "$flake/.sops.yaml") == 1 ]] || fail 'Titan recipient not in reviewed SOPS policy'
for encrypted in secrets/secrets.yaml secrets/immich.enc.env secrets/twitch-api-token.json; do
  [[ -r $flake/$encrypted ]] || fail "missing encrypted $encrypted"
  grep -Fq -- "$recipient" "$flake/$encrypted" || fail "Titan recipient absent from $encrypted; rekey first"
  # The ciphertext uses an age1 recipient derived from Titan's SSH key. Convert the
  # SSH identity in a private pipe: neither the SSH key nor the age identity enters
  # argv, logs, disk, or the Nix store. Disable every other local identity source.
  env -i PATH="$PATH" HOME=/nonexistent GNUPGHOME=/nonexistent SOPS_GPG_EXEC=/bin/false \
    SOPS_AGE_KEY_CMD="ssh-to-age -private-key -i $key" \
    sops decrypt "$flake/$encrypted" >/dev/null 2>/dev/null || fail "Titan-only identity cannot decrypt $encrypted"
done
git -C "$flake" ls-files --error-unmatch -- hosts/titan/target-disk.nix >/dev/null || fail 'target-disk.nix must be tracked in the full root flake'
changes=$(git -C "$flake" status --porcelain -- hosts/titan/target-disk.nix) || fail 'cannot inspect target-disk.nix git status'
[[ -z $changes ]] || fail 'target-disk.nix already modified; review/commit separately before applying'
[[ $(grep -Fc 'disko.devices.disk.main.device = throw ' "$flake/hosts/titan/target-disk.nix") == 1 ]] || fail 'target-disk.nix not at safe placeholder'
[[ -w $flake/hosts/titan/target-disk.nix ]] || fail 'target disk module not writable'
[[ -z ${NIX_CONFIG-} ]] || fail 'NIX_CONFIG already set; unset it before apply'
command -v gh >/dev/null || fail 'gh unavailable: install CLI and log in interactively to GitHub on USB before apply'
# Never print the OAuth token or run set -x. GH auth is only scoped to the build process.
if ! token=$(gh auth token 2>/dev/null) || [[ -z $token ]]; then fail 'GitHub login missing: run gh auth login interactively on USB'; fi
printf '\nTARGET: %s / %s / %s bytes / serial %s\n' "$disk_id" "$model" "$size" "$serial"
printf 'Stage a disk-bound configuration and build Titan BEFORE any formatting? Type the exact disk serial: '
read -r reply
[[ $reply == "$serial" ]] || fail 'first confirmation failed'
# Validate the USB's root-only signing bundle before staging/building or any target writes.
/run/wrappers/bin/sudo /run/current-system/sw/bin/bash "$self" --pki-check || fail 'Secure Boot signing PKI preflight failed'
# Only the path, never credentials, is placed in the tracked source. This same module
# also binds Disko's generated script to /mnt/titan (CLI rootMountPoint is ignored for NixOS modules).
printf '{ ... }: { disko.devices.disk.main.device = "%s"; disko.rootMountPoint = "%s"; }\n' "$disk_id" "$mount_root" > "$flake/hosts/titan/target-disk.nix"
printf 'Staged %s/hosts/titan/target-disk.nix; review and commit this path before future rebuilds.\n' "$flake"
# Nix's git flake snapshot ignores untracked files but includes tracked modified files.
system=$(NIX_CONFIG="access-tokens = github.com=$token" nix build --no-link --print-out-paths "$flake#nixosConfigurations.titan.config.system.build.toplevel") || fail 'Titan prebuild failed; disk untouched, staged target-disk.nix remains for review'
[[ $system == /nix/store/* && -d $system ]] || fail 'invalid prebuilt system path'
# Pinned Disko NixOS module exports system.build.destroyFormatMount. Its rootMountPoint
# is read from the staged target module; cli.nix's parameter is ignored for NixOS modules.
disko_script=$(NIX_CONFIG="access-tokens = github.com=$token" nix build --no-link --print-out-paths "$flake#nixosConfigurations.titan.config.system.build.destroyFormatMount") || fail 'cannot prebuild pinned Disko script; disk untouched'
[[ $disko_script == /nix/store/* && -x $disko_script/bin/disko-destroy-format-mount ]] || fail 'invalid Disko script'
# Resolve the actual Home Manager persistence config, not a handwritten list.
metadata=$(mktemp /run/user/1000/titan-hm.XXXXXXXX) || fail 'cannot stage HM path metadata in user runtime'
chmod 0600 -- "$metadata"
trap 'if [[ -n ${metadata-} ]]; then rm -f -- "$metadata"; fi' EXIT
hm_attr="${flake}#nixosConfigurations.titan.config.home-manager.users.zarred.home.persistence.\"/persist\""
# Impermanence's entry sets expose deprecated lazy fields such as `method`;
# project only the path before JSON encoding so that normal HM eval can succeed.
dirs=$(NIX_CONFIG="access-tokens = github.com=$token" nix eval --json --apply 'xs: map (v: if builtins.isString v then v else v.directory) xs' "$hm_attr.directories") || fail 'cannot evaluate Titan HM persistent directories'
files=$(NIX_CONFIG="access-tokens = github.com=$token" nix eval --json --apply 'xs: map (v: if builtins.isString v then v else v.file) xs' "$hm_attr.files") || fail 'cannot evaluate Titan HM persistent files'
unset token NIX_CONFIG
jq -je '.[] | "D\u0000", ., "\u0000"' <<< "$dirs" > "$metadata" || fail 'malformed HM directories'
jq -je '.[] | "F\u0000", ., "\u0000"' <<< "$files" >> "$metadata" || fail 'malformed HM files'
validate_metadata "$metadata"
metadata_sha=$(sha256sum < "$metadata"); metadata_sha=${metadata_sha%% *}
check_disk "$disk_id" "$resolved"
[[ $serial == "$(lsblk -dnro SERIAL -- "$resolved" | xargs)" ]] || fail 'disk identity changed after build'
printf '\nDESTRUCTIVE: wipe ALL DATA on %s (%s), serial %s.\n' "$disk_id" "$model" "$serial"
printf 'Type WIPE %s to authorize destruction: ' "$serial"
read -r reply
[[ $reply == "WIPE $serial" ]] || fail 'destructive confirmation failed'
# Revalidate in privileged child immediately before Disko. The same by-id path and prebuilt script are used.
/run/wrappers/bin/sudo /run/current-system/sw/bin/bash "$self" --root-stage "$disk_id" "$resolved" "$serial" "$system" "$disko_script" "$key" "$metadata" "$metadata_sha" || fail 'root installation incomplete; leave mounts untouched and inspect manually'
printf '%s\n' 'Titan install finished. Inspect boot and SOPS services on first boot; no reboot performed.'
