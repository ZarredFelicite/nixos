#!/usr/bin/env bash
set -euo pipefail

# tmux-resurrect reads `last` repeatedly, so resolve a usable save before the
# plugin's earliest restore boundary. This also covers continuum's auto-restore.
tmux_value() {
  tmux show-option -gqv "$1" 2>/dev/null || true
}

resurrect_dir="$(tmux_value @resurrect-dir)"
resurrect_dir="${resurrect_dir:-$HOME/.tmux/resurrect}"
resurrect_dir="${resurrect_dir/\$HOME/$HOME}"
resurrect_dir="${resurrect_dir/\$HOSTNAME/$(hostname)}"
[[ "$resurrect_dir" == '~/'* ]] && resurrect_dir="$HOME/${resurrect_dir#~/}"

complete_save() {
  local candidate="$1"
  [[ -f "$candidate" ]] || return 1
  grep -q $'^pane\t' "$candidate" && grep -q $'^window\t' "$candidate"
}

upstream="$(tmux_value @pi-resurrect-upstream-restore)"
last="$resurrect_dir/last"
if complete_save "$last"; then
  [[ -n "$upstream" && -x "$upstream" ]] || {
    printf '%s\n' 'tmux-resurrect: upstream restore script is unavailable' >&2
    exit 0
  }
  exec "$upstream"
fi

candidate=""
candidate_mtime=0
for candidate_path in "$resurrect_dir"/resurrect_*.txt; do
  [[ -e "$candidate_path" ]] || continue
  complete_save "$candidate_path" || continue
  mtime="$(stat -c %Y "$candidate_path" 2>/dev/null || printf '0')"
  if (( mtime >= candidate_mtime )); then
    candidate="$candidate_path"
    candidate_mtime="$mtime"
  fi
done

if [[ -z "$candidate" ]]; then
  printf '%s\n' 'tmux-resurrect: no complete save available; restore skipped' >&2
  exit 0
fi

[[ -n "$upstream" && -x "$upstream" ]] || {
  printf '%s\n' 'tmux-resurrect: upstream restore script is unavailable' >&2
  exit 0
}

temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/pi-resurrect-restore.XXXXXX")"
cleanup() { rm -f "$temporary_dir/last"; rmdir "$temporary_dir"; }
trap cleanup EXIT
ln -s "$(readlink -f "$candidate")" "$temporary_dir/last"
export _RESURRECT_DIR="$temporary_dir"
exec "$upstream"
